# VM host port exposed for this app
DP_HOST_PORT=8889

# App runtime
APP_HOST=0.0.0.0
APP_PORT=8889
DP_DEBUG_MODE=false

# Elasticsearch connection
ES_HOST=https://your-elasticsearch:9200
ES_API_KEY=your-elasticsearch-api-key
ES_VERIFY_CERTS=false
ES_ACCEPT_HEADER=application/vnd.elasticsearch+json; compatible-with=8

# Elasticsearch query behavior
ES_INDEX=logstash-*
ES_TYPE=Cowrie
ES_EXCLUDE_REGEX=139\\.91\\..*
ES_MAX_RESULTS=10000
